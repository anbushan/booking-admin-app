generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String?
  email       String?
  role        String   @default("PASSENGER") // PASSENGER, DRIVER, ADMIN — whichever one is currently active
  // Same phone number can register/operate as both a driver and a
  // passenger — `role` above is just which one is active right now
  // (switchable, see PUT /api/users/me/role); these two track which
  // profile(s) actually exist so login knows whether to ask which one
  // to use, and so switching to a role for the first time is
  // distinguishable from switching back to one already set up.
  isDriver    Boolean  @default(false)
  isPassenger Boolean  @default(false)
  photoUrl    String?
  ratingAvg   Float?
  disabled    Boolean  @default(false)
  fcmToken    String?
  createdAt   DateTime @default(now())

  // Alternative to requesting a fresh SMS OTP every login — a static
  // 6-digit code the user downloads once (see POST /api/auth/passcode)
  // and can log in with directly from any device. Hashed like a
  // password, never stored or re-shown in plaintext after generation.
  // Deliberately weaker than OTP (it doesn't expire on its own), which
  // is why it can be revoked independently — see
  // POST /api/auth/passcode/revoke — without touching OTP login at all.
  passcodeHash      String?
  passcodeCreatedAt DateTime?

  // Consent flag for WhatsApp messaging — opt-in, defaults off. Purely
  // a preference the user controls (checkbox at signup, editable later
  // from Profile); nothing in this codebase sends WhatsApp messages
  // yet, but whatever eventually does must check this first rather
  // than messaging everyone who has a phone number on file.
  whatsappOptIn Boolean @default(false)

  // Passenger repeat-cancel cooldown (3rd late-cancel in N days -> blocked
  // from booking for a period). Just a timestamp, so it auto-lifts on its own.
  bookingCooldownUntil DateTime?

  // Driver strike system (rolling-window count lives on DriverStrike rows,
  // not a counter here — see issueDriverStrike in lib/strikes.js).
  strikeFlagged      Boolean   @default(false)
  strikeBlockedUntil DateTime?

  vehicles           Vehicle[]
  ridesAsDriver      Ride[]
  bookingsAsPassenger Booking[]
  emergencyContacts  EmergencyContact[]
  documents          Document[]
  notifications      Notification[]
  reviewsGiven       Review[] @relation("ReviewsGiven")
  reviewsReceived    Review[] @relation("ReviewsReceived")
  driverStrikes      DriverStrike[]
}

model Vehicle {
  id            String   @id @default(cuid())
  driverId      String
  driver        User     @relation(fields: [driverId], references: [id])
  make          String
  model         String
  regNumber     String
  color         String?
  // Total seats in the vehicle (driver's own seat included) — used to
  // cap Ride.seatsAvailable and shown to passengers in search ("5-seater").
  seatCapacity  Int?
  createdAt     DateTime @default(now())

  rides         Ride[]
}

model Ride {
  id              String   @id @default(cuid())
  driverId        String
  driver          User     @relation(fields: [driverId], references: [id])
  // Which of the driver's vehicles this specific ride uses — set at
  // publish time (auto-picked if the driver only has one). Lets search
  // show the real vehicle instead of guessing when a driver owns several.
  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  sourceLat       Float
  sourceLng       Float
  sourceAddress   String
  destLat         Float
  destLng         Float
  destAddress     String
  routePolyline   String?
  // Ordered source -> dest: [{ lat, lng, placeName, distanceKm, durationMinutes }, ...],
  // distanceKm/durationMinutes cumulative from source. Set once, at publish
  // time, from whichever Directions API alternative the driver picked (see
  // lib/directions.js) — null for rides published before this existed, or
  // where Directions couldn't resolve a route. Search/detour checks fall
  // back to a straight-line source-point check when this is null.
  routeStops      Json?
  routeDistanceKm Float?
  routeDurationMinutes Int?
  maxDetourKm     Float    @default(3)
  travelDate      DateTime
  seatsAvailable  Int
  pricePerSeat    Decimal
  preferences     Json     @default("{}")
  status          String   @default("PUBLISHED") // PUBLISHED, CANCELLED, COMPLETED
  createdAt       DateTime @default(now())

  bookings        Booking[]
}

model Booking {
  id                String   @id @default(cuid())
  rideId            String
  ride              Ride     @relation(fields: [rideId], references: [id])
  passengerId       String
  passenger         User     @relation(fields: [passengerId], references: [id])
  seatsBooked       Int      @default(1)

  pickupLat         Float
  pickupLng         Float
  pickupAddress     String
  isCustomPickup    Boolean  @default(false)
  dropLat           Float?
  dropLng           Float?
  dropAddress       String?
  isCustomDrop      Boolean  @default(false)

  status            String   @default("BOOKED")
  // BOOKED, REJECTED, EXPIRED, AWAITING_PAYMENT, CHARGE_ATTEMPTED,
  // PAYMENT_PENDING, CONFIRMED, IN_PROGRESS, STOPPED, COMPLETED, CANCELLED

  expiresAt         DateTime?
  // Why a booking in BOOKED or AWAITING_PAYMENT went to EXPIRED —
  // "NO_DRIVER_RESPONSE" | "PAYMENT_WINDOW" — lets the sweep pick the
  // right notification copy for each case.
  expiryReason      String?

  tripOtp           String?
  otpVerifiedAt     DateTime?
  tripStartedAt     DateTime?
  tripStoppedAt     DateTime?
  tripCompletedAt   DateTime?

  // Platform-fee-upfront payment model: the fee is frozen at accept-time
  // (so a later AppConfig % change never retroactively changes what's
  // owed), platformFeePaidAt is both "payment succeeded" and the moment
  // the shared 30-min grace-cancel window starts. The remaining fare is
  // never charged in-app — settled directly between passenger and driver.
  platformFeeAmount        Decimal?
  platformFeePaidAt        DateTime?
  remainingFareAmount      Decimal?
  remainingFareCollectedAt DateTime?

  // Cancellation matrix bookkeeping.
  cancelledBy       String?   // PASSENGER, DRIVER, SYSTEM
  cancelReason      String?   // PASSENGER_REQUEST, DRIVER_REQUEST, NO_SHOW_DRIVER
  cancelledAt       DateTime?

  lastLocationAt    DateTime?
  lastLat           Float?
  lastLng           Float?
  razorpayPaymentId String?

  // Unread-chat-badge bookkeeping — when each side last opened this
  // booking's conversation. A message is "unread" for a given party if
  // it was sent by the other party after that party's own timestamp
  // here. Two plain columns rather than a generic per-user read-state
  // table since a booking only ever has exactly two participants
  // (passenger, driver) — same lightweight-field style as cancelledBy/
  // cancelReason above rather than a relation for something this small.
  passengerLastReadAt DateTime?
  driverLastReadAt    DateTime?

  createdAt         DateTime @default(now())

  refund            Refund?
  callLogs          CallLog[]
  sosAlerts         SosAlert[]
}

model Refund {
  id                    String   @id @default(cuid())
  bookingId             String   @unique
  booking               Booking  @relation(fields: [bookingId], references: [id])
  amount                Decimal
  status                String   @default("INITIATED") // INITIATED, PROCESSING, COMPLETED, FAILED
  initiatedAt           DateTime @default(now())
  estimatedCompletionAt DateTime
  completedAt           DateTime?
  razorpayRefundId      String?
}

model CallLog {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id])
  callerId     String
  calleeId     String
  proxyNumber  String
  durationSec  Int?
  status       String   @default("INITIATED")
  createdAt    DateTime @default(now())
}

// One row per strike-worthy driver incident (late cancel past the grace
// window, or a no-show). Strike *count* for tier evaluation is a
// rolling-window count() query against these rows, not a counter column,
// so changing AppConfig's rolling-window setting re-evaluates correctly
// without a backfill. See lib/strikes.js issueDriverStrike().
model DriverStrike {
  id        String   @id @default(cuid())
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  bookingId String?
  rideId    String?
  reason    String   // DRIVER_LATE_CANCEL, NO_SHOW
  createdAt DateTime @default(now())
}

model EmergencyContact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String
  relation  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SosAlert {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  triggeredBy   String
  lat           Float
  lng           Float
  contactedIds  String[]
  status        String   @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  createdAt     DateTime @default(now())
}

model Document {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  docType      String   // LICENSE, RC, INSURANCE
  r2Key        String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  uploadedAt   DateTime @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  title       String
  body        String
  read        Boolean  @default(false)
  pushSent    Boolean  @default(false)
  // Which booking this notice is about, when it's about one at all — no
  // relation (just a plain id, matching this schema's existing style for
  // lightweight optional references) since a handful of notification
  // types are account-level, not tied to any single trip. Lets the
  // notifications list filter out ones whose booking has since gone
  // terminal, showing only what's still relevant right now.
  bookingId   String?
  createdAt   DateTime @default(now())
}

model AdminRole {
  id        String   @id @default(cuid())
  adminId   String
  role      String   // super_admin, finance, verification, support
  createdAt DateTime @default(now())
}

model AppConfig {
  id                  String   @id @default(cuid())
  // Renamed from commissionPercent — was unused code-wide, so a free
  // rename. "Platform fee" matches the upfront-charge role this now
  // plays (the old name implied a post-trip cut, which no longer exists).
  platformFeePercent  Float    @default(10)
  fareCapPerKmInr     Float    @default(12)
  defaultMaxDetourKm  Float    @default(3)
  bookingExpiryMinutes Int     @default(20)
  refundWorkingDays   Int      @default(3)

  // Booking accept -> platform-fee payment window.
  paymentWindowMinutes Int     @default(30)
  // Shared cancel-free-of-charge window, starting at platformFeePaidAt.
  graceCancelWindowMinutes Int @default(30)
  // How far past ride.travelDate before an un-started CONFIRMED booking
  // auto-cancels as a driver no-show.
  noShowGraceMinutes  Int      @default(15)

  // Passenger repeat-cancel cooldown: Nth late-cancel (past the grace
  // window) within a rolling window of days triggers a booking cooldown.
  passengerCooldownCancelCount Int @default(3)
  passengerCooldownWindowDays  Int @default(7)
  passengerCooldownHours       Int @default(24)

  // Driver strike tiers, evaluated over a rolling window of days.
  strikeWarningThreshold      Int @default(3)
  strikeFinalWarningThreshold Int @default(5)
  strikeBlockThreshold        Int @default(7)
  strikeBlockDays             Int @default(2)
  strikeRollingWindowDays     Int @default(30)

  // Mobile checks this on launch (GET /api/app-status, no auth) and
  // shows a blocking maintenance screen instead of the app when true —
  // for planned downtime (DB migration, provider outage) without
  // needing an app-store update to communicate it.
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?

  updatedAt           DateTime @updatedAt
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  type      String   @unique // matches Notification.type values
  title     String
  body      String   // supports {placeholder} tokens
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id         String   @id @default(cuid())
  bookingId  String
  senderId   String
  text       String
  // "TEXT" | "LOCATION" — for a LOCATION message, text holds "lat,lng"
  // rather than a new lat/lng column pair.
  type       String   @default("TEXT")
  createdAt  DateTime @default(now())
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String
  fromUserId   String
  fromUser     User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User     @relation("ReviewsReceived", fields: [toUserId], references: [id])
  rating       Int      // 1-5
  comment      String?
  flagged      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  resetToken         String?
  resetTokenExpiresAt DateTime?
  createdAt          DateTime  @default(now())
}
