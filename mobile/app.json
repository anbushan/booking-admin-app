{
  "expo": {
    "name": "NanbaGO",
    "slug": "carpool",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carpool.app"
    },
    "android": {
      "package": "com.carpool.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F1EFE8",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDY3pENaSjXmwLYff3D1HZZ77jkg-JMYVo"
        }
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "We use your location during an active trip so the other rider can track progress and to power the SOS button."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach your profile photo, a car photo, and vehicle documents (RC, license) when adding a vehicle."
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F1EFE8"
        }
      ],
      "./plugins/withDisableForceDark",
      "expo-speech-recognition"
    ],
    "extra": {
      "eas": {
        "projectId": "f79f25ad-1348-4d94-8ced-c2d912d8cc85"
      }
    },
    "owner": "anbu11"
  }
}
