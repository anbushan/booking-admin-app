generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String?
  email       String?
  role        String   @default("PASSENGER") // PASSENGER, DRIVER, ADMIN — whichever one is currently active
  // Same phone number can register/operate as both a driver and a
  // passenger — `role` above is just which one is active right now
  // (switchable, see PUT /api/users/me/role); these two track which
  // profile(s) actually exist so login knows whether to ask which one
  // to use, and so switching to a role for the first time is
  // distinguishable from switching back to one already set up.
  isDriver    Boolean  @default(false)
  isPassenger Boolean  @default(false)
  photoUrl    String?
  // R2 object key for an uploaded profile photo — photoUrl above was
  // never actually wired up to anything (nothing ever set it), and
  // isn't reusable as-is since this app's R2 bucket is private (same
  // as Document uploads): a real display URL has to be a short-lived
  // signed one generated on read, not a stored permanent link.
  photoR2Key  String?
  ratingAvg   Float?
  disabled    Boolean  @default(false)
  // Self-service account deletion (Settings → Delete account). Reuses
  // `disabled` (already checked at login and on every authenticated
  // request — see middleware/auth.js) to block the account immediately;
  // this timestamp just distinguishes "deleted by the user" from a
  // manual admin suspension, and PII (name/email/photo/fcmToken/
  // passcode) is scrubbed at the same time. The row itself is never
  // hard-deleted — other users' ride/booking/rating history still
  // references it, and dropping it would corrupt their records.
  deletedAt   DateTime?
  fcmToken    String?
  createdAt   DateTime @default(now())

  // Alternative to requesting a fresh SMS OTP every login — a static
  // 6-digit code the user downloads once (see POST /api/auth/passcode)
  // and can log in with directly from any device. Hashed like a
  // password, never stored or re-shown in plaintext after generation.
  // Deliberately weaker than OTP (it doesn't expire on its own), which
  // is why it can be revoked independently — see
  // POST /api/auth/passcode/revoke — without touching OTP login at all.
  passcodeHash      String?
  passcodeCreatedAt DateTime?

  // Consent flag for WhatsApp messaging — opt-in, defaults off. Purely
  // a preference the user controls (checkbox at signup, editable later
  // from Profile); nothing in this codebase sends WhatsApp messages
  // yet, but whatever eventually does must check this first rather
  // than messaging everyone who has a phone number on file.
  whatsappOptIn Boolean @default(false)

  // Passenger repeat-cancel cooldown (3rd late-cancel in N days -> blocked
  // from booking for a period). Just a timestamp, so it auto-lifts on its own.
  bookingCooldownUntil DateTime?

  // Driver strike system (rolling-window count lives on DriverStrike rows,
  // not a counter here — see issueDriverStrike in lib/strikes.js).
  strikeFlagged      Boolean   @default(false)
  strikeBlockedUntil DateTime?

  // This user's own shareable invite code — generated lazily on first
  // visit to the "Refer & earn" screen (see referrals.routes.js GET /me),
  // not at signup, so an account created before this feature existed
  // still gets one the first time it's actually needed.
  referralCode String? @unique

  vehicles           Vehicle[]
  ridesAsDriver      Ride[]
  bookingsAsPassenger Booking[]
  emergencyContacts  EmergencyContact[]
  documents          Document[]
  notifications      Notification[]
  reviewsGiven       Review[] @relation("ReviewsGiven")
  reviewsReceived    Review[] @relation("ReviewsReceived")
  driverStrikes      DriverStrike[]
  driverVerification DriverVerification?
  passengerVerification PassengerVerification?
  recurringRideTemplates RecurringRideTemplate[]
  credits            UserCredit[]
  referralsMade      Referral[] @relation("ReferralsMade")
  referralReceived   Referral?  @relation("ReferralReceived")
  promoCodeRedemptions PromoCodeRedemption[]
}

model Vehicle {
  id            String   @id @default(cuid())
  driverId      String
  driver        User     @relation(fields: [driverId], references: [id])
  make          String
  model         String
  regNumber     String
  color         String?
  // Total seats in the vehicle (driver's own seat included) — used to
  // cap Ride.seatsAvailable and shown to passengers in search ("5-seater").
  seatCapacity  Int?
  createdAt     DateTime @default(now())

  // R2 object keys — same private-bucket + signed-view-URL pattern as
  // Document (see documents.routes.js), scoped to this vehicle instead
  // of the driver generally, since a driver can have more than one
  // vehicle and each needs its own RC. photoR2Key is the only optional
  // one of the three; the app enforces rcR2Key as required on new
  // submissions (nullable here only so this migration doesn't break on
  // existing rows).
  photoR2Key    String?
  rcR2Key       String?
  dlR2Key       String?

  // A vehicle can't be used to publish a ride until an admin approves
  // it (see rides.routes.js's create-ride check) — existing vehicles
  // get backfilled straight to APPROVED by this migration so no
  // currently-active driver is retroactively blocked.
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedAt    DateTime?
  reviewedBy    String?
  // Set by admin when rejecting — shown to the driver so re-uploading
  // isn't a guess. Cleared automatically whenever the driver resubmits
  // (see vehicles.routes.js PUT /:id).
  rejectionReason String?

  rides         Ride[]
  verification  VehicleVerification?
  recurringRideTemplates RecurringRideTemplate[]

  @@index([driverId])
  @@index([status])
}

model Ride {
  id              String   @id @default(cuid())
  driverId        String
  driver          User     @relation(fields: [driverId], references: [id])
  // Which of the driver's vehicles this specific ride uses — set at
  // publish time (auto-picked if the driver only has one). Lets search
  // show the real vehicle instead of guessing when a driver owns several.
  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  sourceLat       Float
  sourceLng       Float
  sourceAddress   String
  destLat         Float
  destLng         Float
  destAddress     String
  routePolyline   String?
  // Ordered source -> dest: [{ lat, lng, placeName, distanceKm, durationMinutes }, ...],
  // distanceKm/durationMinutes cumulative from source. Set once, at publish
  // time, from whichever Directions API alternative the driver picked (see
  // lib/directions.js) — null for rides published before this existed, or
  // where Directions couldn't resolve a route. Search/detour checks fall
  // back to a straight-line source-point check when this is null.
  routeStops      Json?
  routeDistanceKm Float?
  routeDurationMinutes Int?
  maxDetourKm     Float    @default(3)
  travelDate      DateTime
  // seatsAvailable is a live DISPLAY figure — for a ride with totalSeats
  // set (see below), it's recomputed after every booking/cancel as the
  // worst-case (bottleneck) segment along the route, not a flat pool
  // (see lib/segments.js). Kept as the same field/name every existing
  // screen already reads so none of them needed to change.
  seatsAvailable  Int
  // Immutable car capacity, set once at publish time from whatever
  // seatsAvailable was given then. Null on any ride published before
  // segment-aware booking shipped — those rides deliberately keep the
  // old flat-pool behavior forever (see lib/segments.js and every call
  // site that branches on `ride.totalSeats == null`), rather than
  // guessing a capacity for bookings that already happened under the
  // old rules.
  totalSeats      Int?
  pricePerSeat    Decimal
  preferences     Json     @default("{}")
  status          String   @default("PUBLISHED") // PUBLISHED, CANCELLED, COMPLETED
  createdAt       DateTime @default(now())

  bookings        Booking[]

  // Set only on a ride auto-generated by a recurring series (see
  // RecurringRideTemplate / cron/generateRecurringRides.js) — null for
  // every normal one-off publish. Lets the generator tell "never
  // generated this date" (create it) apart from "generated, then the
  // driver cancelled just this occurrence" (leave it cancelled, see the
  // generator's own comment for why this is checked regardless of
  // status), and lets the UI show a "Recurring" badge on the ride card.
  recurringTemplateId String?
  recurringTemplate    RecurringRideTemplate? @relation(fields: [recurringTemplateId], references: [id])

  @@index([driverId])
  // Matches the actual search query shape (rides.routes.js GET /search):
  // status: "PUBLISHED" + a travelDate range, ordered by travelDate — a
  // composite index lets Postgres satisfy the filter and the sort from
  // the same index scan instead of a filter-then-sort.
  @@index([status, travelDate])
  @@index([recurringTemplateId])
}

// A driver's "repeat this ride" setup — one row per series. The route/
// price/seat/preference fields here are the template every future
// occurrence is generated from; editing them (see recurringRides.routes.js's
// deliberately v1-scoped PATCH) never touches already-generated Ride
// rows, only future ones. Route data (polyline/stops/distance) is
// computed once here at creation and reused for every occurrence
// rather than re-fetched from Google Directions on each generation —
// a commute's route doesn't change day to day.
model RecurringRideTemplate {
  id              String    @id @default(cuid())
  driverId        String
  driver          User      @relation(fields: [driverId], references: [id])
  vehicleId       String
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id])

  sourceLat            Float
  sourceLng            Float
  sourceAddress        String
  destLat              Float
  destLng              Float
  destAddress          String
  routePolyline        String?
  routeStops           Json?
  routeDistanceKm      Float?
  routeDurationMinutes Int?
  maxDetourKm          Float    @default(3)

  // "HH:mm", applied to every generated date — a recurring ride is the
  // same departure time every day it runs, not a range.
  departureTime   String
  seatsAvailable  Int
  pricePerSeat    Decimal
  preferences     Json     @default("{}")

  // 0=Sun..6=Sat — which weekdays this repeats on. Postgres native int
  // array, no join table needed for a handful of small ints.
  daysOfWeek      Int[]
  startDate       DateTime
  // null = indefinite, keeps generating until the driver pauses/stops it.
  endDate         DateTime?
  // Paused (temporarily) vs stopped is the same flag — DELETE just also
  // cancels future not-yet-CONFIRMED occurrences on top of setting this
  // false; a driver can still flip it back on via PATCH either way.
  active          Boolean  @default(true)

  generatedRides  Ride[]
  createdAt       DateTime @default(now())

  @@index([driverId])
  @@index([active])
}

model Booking {
  id                String   @id @default(cuid())
  rideId            String
  ride              Ride     @relation(fields: [rideId], references: [id])
  passengerId       String
  passenger         User     @relation(fields: [passengerId], references: [id])
  seatsBooked       Int      @default(1)

  pickupLat         Float
  pickupLng         Float
  pickupAddress     String
  isCustomPickup    Boolean  @default(false)
  dropLat           Float?
  dropLng           Float?
  dropAddress       String?
  isCustomDrop      Boolean  @default(false)
  // This booking's actual pickup/drop projected onto the ride's own
  // routePolyline as distance-from-source (km) — set once at booking
  // creation (see lib/directions.js progressAlongRouteKm, same helper
  // search matching already uses). Null whenever the ride has no stored
  // polyline (legacy/"Publish anyway" rides) or a custom point couldn't
  // be projected — those bookings fall back to occupying the ride's
  // whole route for capacity purposes, same as before this existed.
  pickupProgressKm  Float?
  dropProgressKm    Float?

  status            String   @default("BOOKED")
  // BOOKED, REJECTED, EXPIRED, AWAITING_PAYMENT, CHARGE_ATTEMPTED,
  // PAYMENT_PENDING, CONFIRMED, IN_PROGRESS, STOPPED, COMPLETED, CANCELLED

  expiresAt         DateTime?
  // Why a booking in BOOKED or AWAITING_PAYMENT went to EXPIRED —
  // "NO_DRIVER_RESPONSE" | "PAYMENT_WINDOW" — lets the sweep pick the
  // right notification copy for each case.
  expiryReason      String?

  tripOtp           String?
  otpVerifiedAt     DateTime?
  tripStartedAt     DateTime?
  tripStoppedAt     DateTime?
  tripCompletedAt   DateTime?

  // Platform-fee-upfront payment model: the fee is frozen at accept-time
  // (so a later AppConfig % change never retroactively changes what's
  // owed), platformFeePaidAt is both "payment succeeded" and the moment
  // the shared 30-min grace-cancel window starts. The remaining fare is
  // never charged in-app — settled directly between passenger and driver.
  platformFeeAmount        Decimal?
  platformFeePaidAt        DateTime?
  remainingFareAmount      Decimal?
  remainingFareCollectedAt DateTime?

  // Cancellation matrix bookkeeping.
  cancelledBy       String?   // PASSENGER, DRIVER, SYSTEM
  cancelReason      String?   // PASSENGER_REQUEST, DRIVER_REQUEST, NO_SHOW_DRIVER
  cancelledAt       DateTime?

  lastLocationAt    DateTime?
  lastLat           Float?
  lastLng           Float?
  razorpayPaymentId String?

  // Unread-chat-badge bookkeeping — when each side last opened this
  // booking's conversation. A message is "unread" for a given party if
  // it was sent by the other party after that party's own timestamp
  // here. Two plain columns rather than a generic per-user read-state
  // table since a booking only ever has exactly two participants
  // (passenger, driver) — same lightweight-field style as cancelledBy/
  // cancelReason above rather than a relation for something this small.
  passengerLastReadAt DateTime?
  driverLastReadAt    DateTime?

  createdAt         DateTime @default(now())

  refund            Refund?
  callLogs          CallLog[]
  sosAlerts         SosAlert[]

  // Every hot path filters by one of these two FKs plus status (ride's
  // own booking list, a driver's active bookings, a passenger's active
  // bookings/history) — composite indexes cover both the FK lookup and
  // the status filter in one scan instead of two.
  @@index([rideId, status])
  @@index([passengerId, status])
  @@index([expiresAt])
  // admin's daily/monthly revenue report (app/reports/daily/page.tsx)
  // filters and sorts by this column with no other filter — was doing a
  // full table scan on every load, worse as Booking grows, since nothing
  // else in the original 20-index pass touched it (that pass covered
  // backend's own hot paths, not admin's report queries).
  @@index([platformFeePaidAt])
}

model Refund {
  id                    String   @id @default(cuid())
  bookingId             String   @unique
  booking               Booking  @relation(fields: [bookingId], references: [id])
  amount                Decimal
  status                String   @default("INITIATED") // INITIATED, PROCESSING, COMPLETED, FAILED
  initiatedAt           DateTime @default(now())
  estimatedCompletionAt DateTime
  completedAt           DateTime?
  razorpayRefundId      String?

  @@index([status])
}

model CallLog {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id])
  callerId     String
  calleeId     String
  proxyNumber  String
  durationSec  Int?
  status       String   @default("INITIATED")
  createdAt    DateTime @default(now())

  @@index([bookingId])
}

// One row per strike-worthy driver incident (late cancel past the grace
// window, or a no-show). Strike *count* for tier evaluation is a
// rolling-window count() query against these rows, not a counter column,
// so changing AppConfig's rolling-window setting re-evaluates correctly
// without a backfill. See lib/strikes.js issueDriverStrike().
model DriverStrike {
  id        String   @id @default(cuid())
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  bookingId String?
  rideId    String?
  reason    String   // DRIVER_LATE_CANCEL, NO_SHOW
  createdAt DateTime @default(now())

  // issueDriverStrike's rolling-window count query (lib/strikes.js) is
  // exactly this: count() where driverId = ? and createdAt >= (now -
  // N days) — a composite index covers it in one scan.
  @@index([driverId, createdAt])
}

model EmergencyContact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String
  relation  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SosAlert {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  triggeredBy   String
  lat           Float
  lng           Float
  contactedIds  String[]
  status        String   @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  createdAt     DateTime @default(now())

  @@index([bookingId])
  @@index([status])
}

model Document {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  docType      String   // LICENSE, RC, INSURANCE
  r2Key        String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  uploadedAt   DateTime @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?

  @@index([userId])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  title       String
  body        String
  read        Boolean  @default(false)
  pushSent    Boolean  @default(false)
  // Which booking this notice is about, when it's about one at all — no
  // relation (just a plain id, matching this schema's existing style for
  // lightweight optional references) since a handful of notification
  // types are account-level, not tied to any single trip. Lets the
  // notifications list filter out ones whose booking has since gone
  // terminal, showing only what's still relevant right now.
  bookingId   String?
  createdAt   DateTime @default(now())

  // Every list fetch is "this user's notifications, newest first" —
  // covers both the FK filter and the sort in one scan.
  @@index([userId, createdAt])
}

model AdminRole {
  id        String   @id @default(cuid())
  adminId   String
  role      String   // super_admin, finance, verification, support
  createdAt DateTime @default(now())

  @@index([adminId])
}

model AppConfig {
  id                  String   @id @default(cuid())
  // Renamed from commissionPercent — was unused code-wide, so a free
  // rename. "Platform fee" matches the upfront-charge role this now
  // plays (the old name implied a post-trip cut, which no longer exists).
  platformFeePercent  Float    @default(10)
  fareCapPerKmInr     Float    @default(12)
  defaultMaxDetourKm  Float    @default(3)
  bookingExpiryMinutes Int     @default(20)
  refundWorkingDays   Int      @default(3)

  // Booking accept -> platform-fee payment window.
  paymentWindowMinutes Int     @default(30)
  // Shared cancel-free-of-charge window, starting at platformFeePaidAt.
  graceCancelWindowMinutes Int @default(30)
  // How far past ride.travelDate before an un-started CONFIRMED booking
  // auto-cancels as a driver no-show.
  noShowGraceMinutes  Int      @default(15)

  // Passenger repeat-cancel cooldown: Nth late-cancel (past the grace
  // window) within a rolling window of days triggers a booking cooldown.
  passengerCooldownCancelCount Int @default(3)
  passengerCooldownWindowDays  Int @default(7)
  passengerCooldownHours       Int @default(24)

  // Driver strike tiers, evaluated over a rolling window of days.
  strikeWarningThreshold      Int @default(3)
  strikeFinalWarningThreshold Int @default(5)
  strikeBlockThreshold        Int @default(7)
  strikeBlockDays             Int @default(2)
  strikeRollingWindowDays     Int @default(30)

  // Mobile checks this on launch (GET /api/app-status, no auth) and
  // shows a blocking maintenance screen instead of the app when true —
  // for planned downtime (DB migration, provider outage) without
  // needing an app-store update to communicate it.
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?

  // Paid third-party (Eko) verification — flat, one-time license fee;
  // RC fee charged per vehicle (every vehicle, including the first).
  licenseVerificationFeeInr Float @default(4)
  vehicleRcFeeInr           Float @default(4)
  // Same idea, passenger-side — flat, one-time Aadhaar identity check.
  aadhaarVerificationFeeInr Float @default(4)

  // Referral program (see UserCredit/Referral below) — what each side
  // earns. Referee's is granted the moment they redeem a code; referrer's
  // only once the referee actually completes a real, paid first ride —
  // see maybeCompleteReferral() in lib/credits.js.
  referralRewardInr Float @default(30)
  refereeRewardInr  Float @default(30)

  updatedAt           DateTime @updatedAt
}

// A user's spendable credit balance — the single ledger both the
// referral program and promo codes feed into, rather than two separate
// ad-hoc discount mechanisms. Applied automatically (see
// applyAvailableCredit in lib/credits.js) the moment a booking's
// platformFeeAmount is frozen (PUT /api/bookings/:id/accept) — never
// re-applied at charge/retry time, so there's exactly one place this can
// ever take effect per booking.
model UserCredit {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  amountInr       Decimal
  source          String    // REFERRAL_REFERRER, REFERRAL_REFEREE, PROMO_CODE
  // Referral.id or PromoCodeRedemption.id this credit came from, for
  // support/dispute lookups ("where did this credit come from?").
  sourceId        String?
  status          String    @default("AVAILABLE") // AVAILABLE, USED
  usedOnBookingId String?
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  // applyAvailableCredit's own query: this user's spendable balance,
  // oldest-first.
  @@index([userId, status])
}

// One row per successful "referee redeemed a referrer's code" — refereeId
// is unique because a person can only ever have been referred once (not
// once per code they happen to see). Referrer keeps their same code
// forever and can refer any number of people.
model Referral {
  id               String    @id @default(cuid())
  referrerId       String
  referrer         User      @relation("ReferralsMade", fields: [referrerId], references: [id])
  refereeId        String    @unique
  referee          User      @relation("ReferralReceived", fields: [refereeId], references: [id])
  status           String    @default("PENDING") // PENDING, COMPLETED
  refereeCreditId  String?
  referrerCreditId String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([referrerId])
}

// Admin-managed discount codes ("first ride free-ish", a launch-city
// promo, etc.) — deliberately separate from the referral program even
// though both grant a UserCredit, since eligibility rules differ (a
// promo code is redeemed by typing a code an admin published, not by
// being personally invited by another user).
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountInr     Decimal
  // Most promo codes exist specifically to get a hesitant first-time
  // user over the trust hurdle — checked at redemption time (zero prior
  // paid bookings), not re-checked when the credit is actually spent.
  firstRideOnly   Boolean   @default(true)
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  redemptions     PromoCodeRedemption[]
}

model PromoCodeRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  creditId    String?
  createdAt   DateTime  @default(now())

  // One redemption per user per code — the actual "have you already used
  // this" guard, not just a nice-to-have index.
  @@unique([promoCodeId, userId])
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  type      String   @unique // matches Notification.type values
  title     String
  body      String   // supports {placeholder} tokens
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id         String   @id @default(cuid())
  bookingId  String
  senderId   String
  text       String
  // "TEXT" | "LOCATION" — for a LOCATION message, text holds "lat,lng"
  // rather than a new lat/lng column pair.
  type       String   @default("TEXT")
  createdAt  DateTime @default(now())

  // Every read is scoped to one booking's conversation (history fetch,
  // unread-count batching across a list of bookingIds) — this is the
  // single most-queried FK in the schema by request volume (chat
  // polling + socket join checks).
  @@index([bookingId])
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String
  fromUserId   String
  fromUser     User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User     @relation("ReviewsReceived", fields: [toUserId], references: [id])
  rating       Int      // 1-5
  comment      String?
  flagged      Boolean  @default(false)
  createdAt    DateTime @default(now())

  // bookingId: the "did the other party already review this booking"
  // lookup (bookings.routes.js GET /:id's reviewForMe). toUserId: "all
  // reviews received" listings (admin, RatingsReceivedScreen).
  @@index([bookingId])
  @@index([toUserId])
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  resetToken         String?
  resetTokenExpiresAt DateTime?
  createdAt          DateTime  @default(now())
}

// Google Play's User Data policy requires account deletion be
// requestable from OUTSIDE the app too, not just via
// DeleteAccountScreen.tsx's in-app flow — a public web page someone
// without the app installed can still use. Deliberately its own simple
// queue rather than trying to trigger the real deletion (User.deletedAt
// + PII scrub, see users.routes.js DELETE /me) straight from an
// unauthenticated web form: that flow is phone-OTP-verified for a
// reason, and a web request has no way to prove who's asking. An admin
// verifies the requester (calls the number back, or matches it against
// a support ticket) before actually deleting — see PATCH
// /api/users/deletion-requests/:id in admin.
model AccountDeletionRequest {
  id          String    @id @default(cuid())
  phone       String
  reason      String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  processedBy String?

  @@index([processedAt])
}

// Paid, self-serve, third-party (Eko) driver verification — replaces
// "must be admin-approved to publish" with "verified is a trust badge,
// publishing is always allowed" (see rides.routes.js POST / and the
// isDriverVerified helper in lib/verification.js). One row per driver:
// license is a driver-level fact, not tied to any one vehicle — verify
// it once and it covers every vehicle that driver ever adds. Existing
// Vehicle.status/Document.status (admin manual review) are untouched
// and still count toward "verified" (see isDriverVerified) — this is
// an additional, faster path to the same badge, not a replacement.
model DriverVerification {
  id                 String    @id @default(cuid())
  driverId           String    @unique
  driver             User      @relation(fields: [driverId], references: [id])

  // Covers this driver's license check AND their first vehicle's RC
  // check together (see VehicleVerification below for the 2nd+ vehicle
  // case, which is its own separate, smaller charge).
  paymentStatus      String    @default("UNPAID") // UNPAID, CHARGE_ATTEMPTED, PAID
  razorpayOrderId    String?
  razorpayPaymentId  String?
  amountPaidInr      Decimal?
  paidAt             DateTime?

  licenseStatus      String    @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, FAILED
  // Eko's full raw response, stored as-is (see lib/eko.js) — only a
  // small derived subset of this actually drives licenseStatus, but the
  // whole thing is kept for support/dispute lookups without needing to
  // re-call Eko.
  licenseEkoResponse Json?
  licenseVerifiedAt  DateTime?

  createdAt          DateTime  @default(now())
}

// One row per vehicle — RC is vehicle-level (each vehicle has its own
// registration). A driver's *first* vehicle is covered by
// DriverVerification's payment above (paymentStatus here stays UNPAID/
// free for it); every vehicle after that needs its own paid RC-only
// check, tracked here independently.
model VehicleVerification {
  id                 String    @id @default(cuid())
  vehicleId          String    @unique
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id])

  paymentStatus      String    @default("UNPAID") // UNPAID (free — 1st vehicle), CHARGE_ATTEMPTED, PAID, WAIVED
  razorpayOrderId    String?
  razorpayPaymentId  String?
  amountPaidInr      Decimal?
  paidAt             DateTime?

  rcStatus           String    @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, FAILED
  rcEkoResponse      Json?
  rcVerifiedAt       DateTime?

  createdAt          DateTime  @default(now())
}

// Passenger-side identity check (Aadhaar) — same pay/check/confirm shape
// as DriverVerification's license, same badge-not-gate rule: booking a
// ride never requires this, it just earns a visible "ID verified" badge
// a driver sees on an incoming request. One row per user (not per role —
// the same account can be both a driver and a passenger, and this is a
// personal identity fact either way).
model PassengerVerification {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])

  paymentStatus      String    @default("UNPAID") // UNPAID, CHARGE_ATTEMPTED, PAID
  razorpayOrderId    String?
  razorpayPaymentId  String?
  amountPaidInr      Decimal?
  paidAt             DateTime?

  aadhaarStatus      String    @default("UNVERIFIED") // UNVERIFIED, PENDING (OTP sent, awaiting verification), VERIFIED, FAILED
  aadhaarEkoResponse Json?
  aadhaarVerifiedAt  DateTime?
  // Real Aadhaar e-KYC is OTP-consent-based, not a plain lookup like DL/RC
  // — UIDAI requires the resident's explicit OTP consent before releasing
  // any demographic data. This holds the transaction id Eko's OTP-initiate
  // call returns, needed to pair with the OTP on the verify call. Cleared
  // once verified/failed/reset — never meaningful outside the PENDING window.
  aadhaarOtpTxnId    String?

  createdAt          DateTime  @default(now())
}
